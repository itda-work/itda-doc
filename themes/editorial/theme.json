{
  "name": "editorial",
  "title": "에디토리얼",
  "description": "크림 바탕에 큰 세리프 제목(Noto Serif KR), 진한 빨강 강조 하나, 가는 괘선, 세리프 큰 인용, 작은 캡션과 넓은 여백",
  "aliases": ["에디토리얼"],
  "extends": "classic",
  "group": "editorial",
  "margin": { "top": "28mm", "right": "26mm", "bottom": "26mm", "left": "26mm" },
  "tokens": {
    "--font-heading": "\"Noto Serif KR\", \"Pretendard\", serif",
    "--paper": "#faf7f2",
    "--ink": "#1a1a1a",
    "--muted": "#6e6a64",
    "--accent": "#a4161a",
    "--accent-ink": "#ffffff",
    "--accent-2": "#e35850",
    "--accent-3": "#ffaba0",
    "--accent-soft": "#ffeae7",
    "--lead-bg": "#fff2f0",
    "--rule": "#c9b79c",
    "--rule-strong": "#1a1a1a",
    "--line-height": "1.75",
    "--header-color": "#6e6a64",
    "--header-rule": "0.5pt solid #c9b79c",
    "--h1-size": "20pt",
    "--h1-color": "#1a1a1a",
    "--h1-weight": "700",
    "--h2-size": "14pt",
    "--h2-color": "#1a1a1a",
    "--h3-size": "11.5pt",
    "--h3-color": "#1a1a1a",
    "--table-head-bg": "transparent",
    "--table-head-ink": "#1a1a1a",
    "--table-top-rule": "1.2pt solid #1a1a1a",
    "--table-border": "#ddd2c0",
    "--table-stripe": "#f3eee5",
    "--code-bg": "#f1ece3",
    "--box-border": "0.75pt solid #c9b79c",
    "--box-bg": "transparent",
    "--lead-bar": "2pt solid #a4161a",
    "--quote-bar": "#a4161a",
    "--quote-ink": "#1a1a1a",
    "--quote-bg": "transparent",
    "--quote-border": "transparent",
    "--caption-color": "#6e6a64",
    "--alert-note": "#3d5a80",
    "--alert-tip": "#2e6b4f",
    "--alert-important": "#6b3e66",
    "--alert-warning": "#8a5a00",
    "--alert-caution": "#a4161a",
    "--alert-todo": "#4e5966",
    "--alert-bg-alpha": "6%",
    "--link": "#3d5a80",
    "--link-hover-ink": "#3d5a80",
    "--link-hover-bg": "#e8edf4",
    "--link-hover-line": "#3d5a80",
    "--chart-1": "#a4161a",
    "--chart-2": "#3d5a80",
    "--chart-3": "#9a6a12",
    "--chart-4": "#2e6f6a",
    "--chart-5": "#6b3e66",
    "--chart-6": "#5e6b2b",
    "--chart-7": "#4b4b4b",
    "--chart-8": "#b4457e",
    "--chart-grid": "#e6dccb",
    "--chart-axis": "#6e6a64"
  },
  "derived": {
    "--accent-2": "oklch(from var(--accent) calc(l + 0.18) c h)",
    "--accent-3": "oklch(from var(--accent) calc(l + 0.37) calc(c * 0.65) h)",
    "--accent-soft": "oklch(from var(--accent) 0.955 calc(c * 0.14) h)",
    "--lead-bg": "oklch(from var(--accent) 0.972 calc(c * 0.09) h)"
  }
}
