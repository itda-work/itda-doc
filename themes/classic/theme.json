{
  "name": "classic",
  "title": "클래식",
  "description": "남색 한 가지 강조색, 띠 두른 표지, 제목 번호, 머리글에 조직·문서 제목",
  "aliases": ["클래식"],
  "group": "basic",
  "cover": "auto",
  "toc-break": true,
  "h1-break": false,
  "margin": { "top": "27mm", "right": "22mm", "bottom": "24mm", "left": "22mm" },
  "header": { "left": "{organization}", "center": "", "right": "{title}" },
  "footer": { "left": "{classification}", "center": "{page} / {pages}", "right": "{doc-no}" },
  "meta": ["doc-no", "version", "date", "author", "검토자", "classification"],
  "labels": { "date": "작성일", "author": "작성", "version": "판", "classification": "보안 등급" },
  "tokens": {
    "--ink": "#1f2633",
    "--muted": "#667085",
    "--accent": "#1d3a6b",
    "--accent-2": "#4d6da2",
    "--accent-3": "#90a7cc",
    "--accent-soft": "#ebf0f9",
    "--rule": "#c9d1dd",
    "--text-size": "10.5pt",
    "--line-height": "1.72",
    "--header-top": "12mm",
    "--footer-bottom": "11mm",
    "--h1-size": "16pt",
    "--h1-color": "var(--accent)",
    "--h2-size": "12.5pt",
    "--h2-color": "var(--accent)",
    "--h3-size": "11pt",
    "--table-head-bg": "var(--accent-soft)",
    "--table-head-ink": "var(--accent)",
    "--table-top-rule": "1.4pt solid var(--accent)",
    "--table-stripe": "#f8fafc",
    "--lead-bg": "#f3f6fc",
    "--lead-bar": "3pt solid var(--accent)",
    "--box-border": "0.75pt solid #c9d1dd",
    "--box-bg": "#fafbfd",
    "--quote-bar": "var(--accent-3)",
    "--chart-1": "var(--accent)",
    "--chart-2": "var(--accent-3)",
    "--chart-3": "#eb6834",
    "--chart-4": "#1baf7a",
    "--chart-5": "#eda100",
    "--chart-6": "#4a3aa7",
    "--chart-7": "#e87ba4",
    "--chart-8": "#008300"
  },
  "derived": {
    "--accent-2": "oklch(from var(--accent) calc(l + 0.18) c h)",
    "--accent-3": "oklch(from var(--accent) calc(l + 0.37) calc(c * 0.65) h)",
    "--accent-soft": "oklch(from var(--accent) 0.955 calc(c * 0.14) h)",
    "--lead-bg": "oklch(from var(--accent) 0.972 calc(c * 0.09) h)"
  }
}
