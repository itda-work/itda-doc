{
  "name": "bold",
  "title": "볼드",
  "description": "강조색 면 표지, 큰 장 번호, 장 앞 쪽 나눔(쪽이 35% 넘게 찼을 때), 넉넉한 여백, 돋보이는 요약문·상자",
  "aliases": ["볼드"],
  "cover": "auto",
  "toc-break": true,
  "h1-break": true,
  "margin": { "top": "28mm", "right": "25mm", "bottom": "26mm", "left": "25mm" },
  "header": { "left": "{title}", "center": "", "right": "{organization}" },
  "footer": { "left": "{organization}", "center": "", "right": "{page} / {pages}" },
  "meta": ["date", "author", "version", "doc-no", "고객사"],
  "labels": { "date": "제출일", "author": "제안", "version": "판", "doc-no": "제안번호" },
  "tokens": {
    "--ink": "#1b1f27",
    "--muted": "#6b7280",
    "--accent": "#d9480f",
    "--accent-2": "#1b1f27",
    "--accent-soft": "#ffede5",
    "--rule": "#e2e4e9",
    "--text-size": "10.5pt",
    "--line-height": "1.78",
    "--paragraph-gap": "8pt",
    "--header-top": "13mm",
    "--footer-bottom": "12mm",
    "--header-rule": "none",
    "--h1-size": "21pt",
    "--h1-color": "#1b1f27",
    "--h1-gap-bottom": "14pt",
    "--h2-size": "13.5pt",
    "--h2-color": "var(--accent)",
    "--h2-gap-top": "20pt",
    "--h3-size": "11.5pt",
    "--table-head-bg": "#1b1f27",
    "--table-head-ink": "#ffffff",
    "--table-top-rule": "none",
    "--table-border": "#e2e4e9",
    "--table-stripe": "#fafafa",
    "--table-cell-pad": "5pt 8pt",
    "--lead-size": "13pt",
    "--lead-bar": "none",
    "--lead-bg": "transparent",
    "--box-border": "none",
    "--box-bg": "var(--accent-soft)",
    "--box-radius": "6pt",
    "--quote-bar": "var(--accent)",
    "--link": "var(--accent)",
    "--chart-1": "var(--accent)",
    "--chart-2": "#3a3f4a",
    "--chart-3": "#f3a77f",
    "--chart-4": "#2a78d6",
    "--chart-5": "#1baf7a",
    "--chart-6": "#eda100",
    "--chart-7": "#4a3aa7",
    "--chart-8": "#e87ba4"
  },
  "derived": {
    "--accent-soft": "oklch(from var(--accent) 0.965 calc(c * 0.16) h)"
  }
}
