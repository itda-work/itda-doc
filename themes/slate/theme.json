{
  "name": "slate",
  "title": "슬레이트",
  "description": "남색 주조에 청록 강조 한 가지, 나머지는 회색. 결론을 앞세운 굵은 제목, 가로줄만 남긴 표, 장식 없는 차분한 격식",
  "aliases": ["슬레이트"],
  "extends": "classic",
  "group": "formal",
  "tokens": {
    "--ink": "#1a1a1a",
    "--muted": "#6b7280",
    "--accent": "#0b2a4a",
    "--accent-2": "#3b5b7e",
    "--accent-3": "#7c92ab",
    "--accent-soft": "#ecf1f7",
    "--highlight": "#0f7c80",
    "--rule": "#d0d5db",
    "--link": "#1f5a96",
    "--h1-size": "16pt",
    "--h1-weight": "800",
    "--h1-color": "var(--accent)",
    "--h2-size": "12.5pt",
    "--h2-color": "var(--accent)",
    "--h3-size": "11pt",
    "--h3-color": "var(--ink)",
    "--table-head-bg": "transparent",
    "--table-head-ink": "var(--accent)",
    "--table-top-rule": "1.4pt solid var(--accent)",
    "--table-border": "var(--rule)",
    "--table-stripe": "transparent",
    "--lead-bg": "#f3f6fa",
    "--lead-bar": "3pt solid var(--highlight)",
    "--box-border": "0.75pt solid var(--rule)",
    "--box-radius": "0",
    "--quote-bar": "var(--highlight)",
    "--alert-note": "#1f5a96",
    "--slide-title-color": "var(--accent)",
    "--chart-1": "var(--accent)",
    "--chart-2": "var(--highlight)",
    "--chart-3": "#778099",
    "--chart-4": "#193a34",
    "--chart-5": "#789b93",
    "--chart-6": "#3e4058",
    "--chart-7": "#646975",
    "--chart-8": "#395a53",
    "--chart-grid": "#e5e7eb",
    "--chart-axis": "#6b7280"
  },
  "derived": {
    "--accent-2": "oklch(from var(--accent) calc(l + 0.18) c h)",
    "--accent-3": "oklch(from var(--accent) calc(l + 0.37) calc(c * 0.65) h)",
    "--accent-soft": "oklch(from var(--accent) 0.955 calc(c * 0.14) h)",
    "--lead-bg": "oklch(from var(--accent) 0.972 calc(c * 0.09) h)"
  }
}
