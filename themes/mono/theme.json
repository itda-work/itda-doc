{
  "name": "mono",
  "title": "모노",
  "description": "흑백, 표지 없이 가운데 제목 블록, 수신·참조 줄, 결재란, 발신 명의, 개조식·공문 목록 기호",
  "aliases": ["모노"],
  "group": "basic",
  "cover": "never",
  "toc-break": false,
  "h1-break": false,
  "list-style": ["gaejosik", "gongmun"],
  "margin": { "top": "22mm", "right": "20mm", "bottom": "24mm", "left": "20mm" },
  "header": { "left": "", "center": "", "right": "{classification}" },
  "footer": { "left": "{doc-no}", "center": "{page} / {pages}", "right": "시행 {시행일}" },
  "meta": ["수신", "경유", "참조"],
  "tokens": {
    "--ink": "#111111",
    "--muted": "#555555",
    "--accent": "#111111",
    "--kpi-up": "var(--ink)",
    "--kpi-down": "var(--ink)",
    "--accent-soft": "#f2f2f2",
    "--rule": "#8a8a8a",
    "--rule-strong": "#111111",
    "--link": "#111111",
    "--link-hover-ink": "var(--paper)",
    "--link-hover-bg": "var(--ink)",
    "--link-hover-line": "var(--paper)",
    "--text-size": "11pt",
    "--line-height": "1.8",
    "--header-rule": "none",
    "--footer-rule": "0.6pt solid #111111",
    "--header-color": "#333333",
    "--h1-size": "12.5pt",
    "--h1-color": "#111111",
    "--h2-size": "11.5pt",
    "--h3-size": "11pt",
    "--table-head-bg": "#efefef",
    "--table-head-ink": "#111111",
    "--table-border": "#111111",
    "--table-top-rule": "1pt solid #111111",
    "--code-bg": "#f2f2f2",
    "--box-border": "0.75pt solid #111111",
    "--box-radius": "0",
    "--lead-bar": "none",
    "--quote-bar": "#111111",
    "--quote-ink": "#222222",
    "--alert-note": "#111111",
    "--alert-tip": "#111111",
    "--alert-important": "#111111",
    "--alert-warning": "#111111",
    "--alert-caution": "#111111",
    "--alert-todo": "#111111",
    "--alert-bg-alpha": "0%",
    "--caption-color": "#333333",
    "--chart-1": "#111111",
    "--chart-2": "#8a8a8a",
    "--chart-3": "#c4c4c4",
    "--chart-4": "#4f4f4f",
    "--chart-5": "#a6a6a6",
    "--chart-6": "#2e2e2e",
    "--chart-7": "#d9d9d9",
    "--chart-8": "#6b6b6b",
    "--chart-grid": "#dddddd",
    "--chart-axis": "#111111"
  }
}
