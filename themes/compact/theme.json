{
  "name": "compact",
  "title": "컴팩트",
  "description": "표지 없이 촘촘한 한 장, 맨 위 정보 표, 눈에 띄는 결정 사항 상자·할 일 표, 초록 강조",
  "aliases": ["컴팩트"],
  "cover": "never",
  "toc-break": false,
  "h1-break": false,
  "margin": { "top": "20mm", "right": "18mm", "bottom": "20mm", "left": "18mm" },
  "header": { "left": "{organization}", "center": "", "right": "{date}" },
  "footer": { "left": "{doc-no}", "center": "{page} / {pages}", "right": "작성 {author}" },
  "meta": ["일시", "장소", "주관", "author", "참석자", "불참"],
  "labels": { "author": "작성", "doc-no": "문서번호" },
  "tokens": {
    "--ink": "#1c2421",
    "--muted": "#5f6b66",
    "--accent": "#1e7a4c",
    "--accent-ink": "#ffffff",
    "--accent-soft": "#e9f8ee",
    "--accent-dark": "#00572c",
    "--rule": "#cdd6d1",
    "--rule-strong": "#1c2421",
    "--text-size": "10pt",
    "--line-height": "1.62",
    "--paragraph-gap": "5pt",
    "--header-top": "9mm",
    "--footer-bottom": "9mm",
    "--header-rule": "none",
    "--h1-size": "13pt",
    "--h1-color": "var(--ink)",
    "--h1-gap-top": "14pt",
    "--h1-gap-bottom": "6pt",
    "--h2-size": "12pt",
    "--h2-color": "var(--ink)",
    "--h2-gap-top": "14pt",
    "--h3-size": "10.5pt",
    "--h3-color": "var(--accent-dark)",
    "--h3-gap-top": "9pt",
    "--table-size": "9.2pt",
    "--table-head-bg": "var(--accent-soft)",
    "--table-head-ink": "var(--accent-dark)",
    "--table-top-rule": "1.2pt solid var(--accent)",
    "--table-cell-pad": "3pt 6pt",
    "--box-border": "0.75pt solid var(--rule)",
    "--box-radius": "2pt",
    "--lead-bar": "3pt solid var(--accent)",
    "--lead-size": "10.5pt",
    "--quote-bar": "var(--accent)",
    "--link": "var(--accent-dark)",
    "--link-hover-ink": "var(--accent-dark)",
    "--caption-size": "8.5pt",
    "--chart-1": "var(--accent)",
    "--chart-2": "#8fcfa8",
    "--chart-3": "#eb6834",
    "--chart-4": "#2a78d6",
    "--chart-5": "#eda100",
    "--chart-6": "#e34948",
    "--chart-7": "#4a3aa7",
    "--chart-8": "#e87ba4"
  },
  "derived": {
    "--accent-soft": "oklch(from var(--accent) 0.965 calc(c * 0.18) h)",
    "--accent-dark": "oklch(from var(--accent) calc(l - 0.12) c h)"
  }
}
