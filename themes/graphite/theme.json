    "--code-type": "#3d3d3d",
    "--code-op": "#595959",
    "--code-title-fg": "#595959",
    "--code-title-line": "#d9d9d9",
    "--code-hl-bg": "#e3e3e3",
    "--code-hl-bar": "#111111",
    "--code-diff-add": "#d9d9d9",
    "--code-diff-del": "#fbfbfb",
    "--mark-bg": "#e3e3e3",
    "--quote-bar": "transparent",
    "--quote-ink": "var(--ink)",
    "--quote-bg": "#f3f3f3",
