    "--tile-radius": "0",
    "--kpi-up": "var(--ink)",
    "--kpi-down": "var(--ink)",
    "--chart-1": "#111111",
    "--chart-2": "#595959",
    "--chart-3": "#8a8a8a",
    "--chart-4": "#0072b2",
    "--chart-5": "#d55e00",
    "--chart-6": "#009e73",
    "--chart-7": "#cc79a7",
    "--chart-8": "#9e6a00",
    "--chart-grid": "#e5e5e5",
    "--chart-axis": "#111111",
    "--diagram-node-bg": "var(--paper)",
    "--diagram-node-border": "var(--ink)",
    "--diagram-edge": "var(--muted)",
    "--diagram-cluster-bg": "#f3f3f3",
