{
  "name": "graphite",
  "title": "그래파이트",
  "description": "흰 바탕에 먹색과 회색 층만으로 세운 위계, 제목 위 굵은 먹 선과 머리표, 네모난 회색 면, 회색 셋 뒤 4~7번 Okabe-Ito·8번 어둡게 한 황토 차트 색",
  "aliases": ["그래파이트"],
  "extends": "classic",
  "group": "formal",
  "tokens": {
    "--ink": "#111111",
    "--muted": "#595959",
    "--accent": "#111111",
    "--accent-2": "#3c3c3c",
    "--accent-3": "#717171",
    "--accent-soft": "#f0f0f0",
    "--lead-bg": "#f6f6f6",
    "--panel": "#f3f3f3",
    "--rule": "#c8c8c8",
    "--rule-strong": "#111111",
    "--link": "var(--accent)",
    "--header-color": "var(--muted)",
    "--footer-rule": "0.5pt solid var(--rule)",
    "--h1-size": "18pt",
    "--h1-color": "var(--ink)",
    "--h1-weight": "800",
    "--h2-size": "13.5pt",
    "--h2-color": "var(--ink)",
    "--h2-weight": "800",
    "--h3-size": "11pt",
    "--h3-color": "var(--ink)",
    "--h3-weight": "700",
